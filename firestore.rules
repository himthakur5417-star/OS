rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Public lead generation: Allow creating an enquiry with required fields, deny direct client reads/updates/deletes
    match /enquiries/{enquiryId} {
      allow create: if request.resource.data.name is string 
                    && request.resource.data.phone is string;
      allow read, update, delete: if false; // Only accessible via secure admin API routes
    }

    // User Directory: Allow authenticated users to read and update ONLY their own user record
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Security Audit & Traffic Logs: Strictly inaccessible via client SDK (server-side only)
    match /login_logs/{logId} {
      allow read, write: if false;
    }

    match /traffic_logs/{trafficId} {
      allow read, write: if false;
    }
  }
}
