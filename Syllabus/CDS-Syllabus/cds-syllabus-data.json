  "ssb_syllabus": {
    "overview": "Five-day evaluation worth 300 marks. Designed to identify Officer Like Qualities (OLQ) and trainability. Three assessors: Interviewing Officer (IO), Group Testing Officer (GTO), and Psychologist.",
    "stages": [
      {
        "stage": "Stage 1 (Screening Test)",
        "tests": [
          "Officer Intelligence Rating (OIR)",
          "Picture Perception and Description Test (PPDT)"
        ]
      },
      {
        "stage": "Stage 2 (Main Assessment)",
        "tests": [
          "Personal Interview with IO",
          "Group Testing Officer (GTO) Indoor & Outdoor Tasks",
          "Psychology Test (TAT, WAT, SRT, SD)",
          "Board Conference"
        ]
      },
      {
        "stage": "Group Discussion & Interaction",
        "tests": [
          "Group Discussion (GD)",
          "Military Planning Exercise (GPE)"
        ]
      }
    ]
  }
